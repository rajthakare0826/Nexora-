rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Global safety net - default deny
    match /{document=**} {
      allow read, write: if false;
    }

    // User-specific collections (Zero-trust isolation)
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /chats/{chatId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /profile/{profileId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /resume_analyses/{analysisId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /roadmaps/{roadmapId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /interviews/{interviewId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /skillgaps/{skillgapId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Telemetry activities collection (Write-only for general public, read for authenticated users)
    match /activities/{activityId} {
      allow create: if true;
      allow read: if request.auth != null;
      allow update, delete: if false;
    }

    // Contact submissions collection rules (Guest create-only, authenticated full access)
    match /contacts/{contactId} {
      allow create: if true;
      allow read, update, delete: if request.auth != null;
    }
  }
}
